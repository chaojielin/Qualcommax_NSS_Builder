#!/bin/sh
# Stop the periodic "disassociated due to inactivity" kicks on the Xiaomi
# AX3600. The NSS Wi-Fi offload hands received data frames straight to the
# Ethernet node, so mac80211 never updates a station's last_rx and hostapd
# reads the frozen value as inactivity. The driver patch under
# patches/tree/ppe-nss makes ath11k advertise NL80211_FEATURE_INACTIVITY_TIMER,
# which stops hostapd arming its inactivity timer at all - raising the timeout
# only postpones the same disconnect.
#
# max_inactivity is deliberately left alone. hostapd.sh only emits
# ap_max_inactivity when the value is greater than 0, so not setting the option
# means hostapd.conf gets no ap_max_inactivity line at all and hostapd falls
# back to its own 300-second default - not to a zero-second timer.
#
# The value no longer decides anything either way, because the driver patch
# stops hostapd arming ap_handle_timer in the first place: both places that
# register it, ap_sta_add() in sta_info.c and hostapd_new_assoc_sta() in
# hostapd.c, are guarded by WPA_DRIVER_FLAGS_INACTIVITY_TIMER.
#
# Running at the default also turns the patch into its own test: if a station
# is still logged as "disassociated due to inactivity" now, the patch is not
# taking effect, because nothing else produces that message on a 300-second
# timeout. Raising max_inactivity would only hide that again.
#
# disassoc_low_ack is off for the same reason as the inactivity timer: with
# the data path in the firmware the host does not see the ACKs either, so
# hostapd would deauthenticate a station that is answering perfectly well.
#
# This is a single-AP setup, so 802.11k neighbor reports and 802.11v BSS
# transition suggestions are off, and the firmware's WNM sleep and time
# advertisement defaults are dropped rather than left on.
#
# Enable both bands as an open AP for initial setup; replace this with a
# secured network and set the router admin password immediately after login.
uci -q set wireless.default_radio0.ieee80211k='0'
uci -q set wireless.default_radio1.ieee80211k='0'
uci -q set wireless.default_radio0.bss_transition='0'
uci -q set wireless.default_radio1.bss_transition='0'
uci -q set wireless.default_radio0.disassoc_low_ack='0'
uci -q set wireless.default_radio1.disassoc_low_ack='0'
uci -q set wireless.default_radio0.wnm_sleep_mode='0'
uci -q set wireless.default_radio1.wnm_sleep_mode='0'
uci -q set wireless.default_radio0.time_advertisement='0'
uci -q set wireless.default_radio1.time_advertisement='0'
uci -q set wireless.default_radio0.encryption='none'
uci -q set wireless.default_radio1.encryption='none'
uci -q delete wireless.default_radio0.key
uci -q delete wireless.default_radio1.key
uci -q set wireless.default_radio0.disabled='0'
uci -q set wireless.default_radio1.disabled='0'
uci -q commit wireless
exit 0
