# Extra packages for the personal AX3600 image. This fragment is only read by
# build-ax3600-personal.yml; the upstream Build workflow never selects it.
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump=y

# --- OpenClash dependencies, without OpenClash ----------------------------
# luci-app-openclash is deliberately NOT selected. It is PKGARCH:=all (plain
# Lua plus static assets), so it can be installed at any time from a matching
# .ipk; its kernel-module dependencies cannot, because a module built against
# another kernel's vermagic will not load. Shipping the dependencies alone
# keeps that door open without carrying an app that is not in use.
#
# Everything the package declares is kept. From its DEPENDS:
#   +dnsmasq-full +bash +curl +ca-bundle +ip-full
#   +ruby +ruby-yaml +kmod-tun +unzip
# and from its Kconfig block:
#   +luci-compat +kmod-inet-diag  (both conditioned on PACKAGE_luci-app-openclash)
#   +kmod-nft-tproxy +dnsmasq_full_nftset  (conditioned on PACKAGE_firewall4,
#     so they stay on regardless; the iptables/ipset alternatives are the
#     !firewall4 branch and never apply here)
# curl comes in with devices/common/config, and kmod-tun with both.
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_dnsmasq=n

# --- busybox applets ------------------------------------------------------
# CONFIG_BUSYBOX_CUSTOM is a prerequisite rather than a preference: the
# CONFIG_BUSYBOX_CONFIG_* symbols are only sourced while it is on, so without
# it Kconfig drops every applet line below and prepare-build.sh fails the
# symbol gate. Switching it on changes no applet by itself - each
# BUSYBOX_CONFIG_* defaults to the matching BUSYBOX_DEFAULT_*, and all 1047 of
# them have one.
#
# Only applets OpenWrt ships switched off are listed. nohup is the one with
# history here: a long-running command backgrounded over ssh dies with the
# session without it, and does so silently, which has already cost a
# debugging round.
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BASE64=y
CONFIG_BUSYBOX_CONFIG_NOHUP=y
CONFIG_BUSYBOX_CONFIG_STAT=y
CONFIG_BUSYBOX_CONFIG_TAC=y

# --- socket statistics ----------------------------------------------------
# kmod-inet-diag is already in for sing-box, but ss is not a busybox applet
# and ip-full does not carry it, so the user-space half was missing.
CONFIG_PACKAGE_ss=y

# --- memory and queueing --------------------------------------------------
# 512 MB running mihomo, sing-box and homekit-go. Both of these are kernel
# modules, which cannot be added later against a different vermagic, so they
# have to be baked in even if they are only wanted occasionally.
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-sched-cake=y

# --- DDNS -----------------------------------------------------------------
# luci-app-ddns with the Cloudflare provider, so the router keeps its own A
# record current. luci-app-ddns pulls ddns-scripts and ucode-mod-math;
# ddns-scripts pulls resolveip, ddns-scripts-services and ip. curl is already
# in.
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# --- Chinese UI -----------------------------------------------------------
# luci-base plus the Simplified Chinese translations. LuCI's luci.main.lang
# defaults to auto, so a Chinese browser picks these up with no further
# configuration.
#
# Selected through LUCI_LANG_zh_Hans, not by naming the individual
# luci-i18n-*-zh-cn packages. Those packages are HIDDEN:=1 in luci.mk, and
# scripts/package-metadata.pl emits a hidden package with an empty prompt
# ("tristate" with no title) and skips the usual "default m if ALL" for it.
# A promptless symbol is not user-settable: an explicit
# CONFIG_PACKAGE_luci-i18n-base-zh-cn=y in this fragment is recomputed away
# by defconfig, and the symbol gate then fails on all of them. Their only
# value source is DEFAULT:=LUCI_LANG_zh_Hans||(ALL&&m), which is what this
# symbol feeds, so setting it here is the supported way in.
#
# The effect is one translation per enabled LuCI app that ships a po/zh_Hans
# catalog - the same set the per-package lines used to name, plus anything
# else the image grows later.
#
# Deliberately absent: luci-app-openclash is not in the image at all (see
# above) and compiles its Chinese strings into the package itself anyway;
# luci-app-ppe-qos and luci-proto-wireguard have no zh_Hans catalog upstream.
CONFIG_LUCI_LANG_zh_Hans=y

# --- HomeKit gateway ------------------------------------------------------
# No symbols: homekit-go is deliberately not baked into the image.
#
# It is a static ARM64 binary that deploy.ps1 pushes over SSH along with its
# LuCI page, init script, uci-defaults and config. A copy here would only go
# stale against the one the deploy installs, and the deploy is idempotent, so
# running it after a flash costs nothing.
#
# Nothing has to be added for it to work once deployed. Its LuCI page needs
# only what luci-base already pulls in: rpcd, rpcd-mod-luci (the luci object
# behind getInitList/getInitAction/setInitAction) and rpcd-mod-file (the ubus
# file object the page runs "homekit-go ctl" through). The daemon is static so
# it needs no libraries, and remote-deploy.sh only uses busybox applets this
# image has.
